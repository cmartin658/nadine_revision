-- from Jonathan Chan
module Hurkens where

Void : Type


neg : Type -> Type


P : Type -> Type


U : Type


tau : (P (P U)) -> U


sigma : U -> P (P U)


Delta : P U


Omega : U


R : (p : P U) -> ((x : U) -> sigma x p -> p x) -> p Omega


M : (x : U) -> sigma x Delta -> Delta x



L : neg ((p : P U) -> ((x : U) -> sigma x p -> p x) -> p Omega)
L = \zero. zero Delta M (\p. zero (\y. p (tau (sigma y))))

false : Void
false = L R
