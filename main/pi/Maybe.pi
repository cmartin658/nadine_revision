module Maybe where

data Maybe (A : Type) : Type where
  Just of (A)
  Nothing

fmap : [A : Type] -> [B : Type] -> (A -> B) -> Maybe A -> Maybe B





zap : [A : Type] -> [B : Type] -> Maybe (A -> B) -> Maybe A -> Maybe B







join : [A : Type] -> Maybe (Maybe A) -> Maybe A






bind : [A : Type] -> [B: Type] -> Maybe A -> (A -> Maybe B) -> Maybe B





